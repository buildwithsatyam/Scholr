# ========================================================
# Medium.AI - Server Environment Configuration
# ========================================================

# Choose one of the following Free-Tier Providers:

# 1. GOOGLE GEMINI (RECOMMENDED - 100% Free Tier, No Credit Card Required)
# Get your free key at: https://aistudio.google.com/app/apikey
# Limits: 15 Requests Per Minute (RPM), 1,500 Requests Per Day (RPD)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. GROQ CLOUD (Alternative High-Speed Free Tier)
# Get your free key at: https://console.groq.com/keys
# Limits: Free access to Llama 3.3 70B & Llama 3.1 8B with sub-second speeds
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# 3. OPENAI / OPENROUTER (Optional)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Server Port (Default: 3001)
PORT=3001

# ========================================================
# Frontend Client Configuration (Vite)
# ========================================================
# In development, the React frontend connects to http://localhost:3001 by default.
# When deployed to GitHub Pages with a hosted backend (e.g. Vercel or Render),
# set this variable in your Vite build or .env.production:
# VITE_AI_API_BASE_URL=https://your-medium-ai-backend.vercel.app

# ========================================================
# Supabase Configuration (Optional Cloud Database & Auth)
# ========================================================
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API to copy your URL and anon key:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
